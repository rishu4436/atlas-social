{
  "name": "atlas-social",
  "private": true,
  "version": "0.1.0",
  "description": "ATLAS Social - the Agent ID-native social trading network on BNB Smart Chain",
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
