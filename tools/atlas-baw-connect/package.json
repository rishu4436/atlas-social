{
  "name": "atlas-social-connect",
  "version": "1.1.0",
  "private": false,
  "license": "MIT",
  "description": "One command to connect to ATLAS Social: installs the official Binance Agentic Wallet CLI if needed, signs you in with Binance's official QR if needed, previews the login, and signs a clean official ATLAS login automatically (use --confirm to review first). Payments always require y.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "atlas-social-connect": "./dist/cli.js",
    "atlas-connect": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "keywords": [
    "atlas",
    "atlas-social",
    "binance",
    "agentic-wallet",
    "baw",
    "connect"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rishu4436/atlas-social.git",
    "directory": "tools/atlas-baw-connect"
  },
  "homepage": "https://atlascalls.xyz",
  "bugs": {
    "url": "https://github.com/rishu4436/atlas-social/issues"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "viem": "^2.58.0",
    "vitest": "^3.2.7"
  }
}
