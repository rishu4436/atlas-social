{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve", "lib": ["dom", "dom.iterable", "ES2022"], "allowJs": false, "noEmit": true, "incremental": true,
    "module": "ESNext", "moduleResolution": "Bundler", "resolveJsonModule": true, "isolatedModules": true, "types": ["node"],
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
