# Copy to .env (never commit real secrets)
NODE_ENV=development
PORT=4000
PUBLIC_ORIGIN=http://localhost:3000
WEB_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgres://atlas@127.0.0.1:5433/atlas
APP_DATABASE_URL=postgres://atlas_app@127.0.0.1:5433/atlas
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
DEPLOYMENT_FILE=../../packages/contracts/deployments/31337.json
AGENT_ID_MODE=onchain
BSC_RPC_URL=https://bsc-rpc.publicnode.com
MARKET_DATA_MODE=live-with-fallback
# Optional OpenAI-compatible LLM for narrative summaries (never commit)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 32-byte base64 key: openssl rand -base64 32
MESSAGE_KEY=
STORAGE_DRIVER=local
STORAGE_DIR=/tmp/atlas-storage
REDIS_URL=
# Disclosed outcome evaluator (local anvil only by default)
EVALUATOR_PRIVATE_KEY=
